<div class="dp-manager-shell is-{{mode}}">
  {{#if isSending}}
  <p class="dp-sending-status" role="status"><i class="fa-solid fa-spinner fa-spin" inert></i> {{localize "DRAWING-PROMPTS.manager.actions.sending"}}</p>
  {{/if}}
  {{#if hasActivePrompt}}
  <div class="dp-review-mode">
    {{#if promptQueue}}
    <label class="dp-prompt-queue">
      <span>{{localize "DRAWING-PROMPTS.manager.queue.label"}}</span>
      <select name="promptQueue" data-action="switchPrompt">
        {{#each promptQueue.options}}
        <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </label>
    {{/if}}
    <div class="dp-summary-bar" aria-label="{{localize 'DRAWING-PROMPTS.manager.summary.label'}}">
      <div class="dp-summary-identity">
        {{#if summary.promptTruncated}}
        <details class="dp-summary-prompt">
          <summary data-tooltip="{{summary.promptText}}">
            <span class="dp-summary-prompt-text">"{{summary.promptPreview}}"</span>
            <span class="dp-summary-toggle" data-tooltip="{{localize 'DRAWING-PROMPTS.manager.summary.expandTooltip'}}">
              <i class="fa-solid fa-chevron-down" inert></i>
            </span>
          </summary>
          <p>"{{summary.promptText}}"</p>
        </details>
        {{else}}
        <span class="dp-summary-prompt-text" data-tooltip="{{summary.promptText}}">"{{summary.promptPreview}}"</span>
        {{/if}}

        <span class="dp-summary-separator" aria-hidden="true"></span>
        <span class="dp-summary-name" data-tooltip="{{localize 'DRAWING-PROMPTS.manager.summary.promptName'}}">{{summary.promptName}}</span>
      </div>

      <div class="dp-timer-block" aria-label="{{localize 'DRAWING-PROMPTS.manager.timer.controls'}}">
        {{#if summary.hasTimer}}
        <div class="dp-timer-adjustments is-minus">
          {{#each timerControls.adjustments}}
          {{#if this.isMinus}}
          <button type="button" data-action="adjustTimer" data-delta-ms="{{this.deltaMs}}" data-tooltip="{{this.tooltip}}" {{#if ../timerControls.disabled}}disabled{{/if}}>{{this.label}}</button>
          {{/if}}
          {{/each}}
        </div>
        <div class="dp-timer-block-center">
          <span class="dp-summary-timer {{#if summary.timerOvertime}}is-overtime{{/if}} {{#if summary.timerPaused}}is-paused{{/if}}" data-tooltip="{{localize 'DRAWING-PROMPTS.manager.summary.timer'}}">
            <i class="fa-regular fa-clock" inert></i>
            <span>{{summary.timerDuration}}</span>
            {{#if summary.timerCountdownText}}
            <span class="dp-summary-countdown {{#if summary.timerOvertime}}is-overtime{{/if}}" data-dp-timer-countdown>{{summary.timerCountdownText}}</span>
            {{/if}}
          </span>
          <div class="dp-timer-controls">
            <button type="button" data-action="toggleTimer" {{#if timerControls.disabled}}disabled{{/if}}>
              <i class="fa-solid {{#if timerControls.paused}}fa-play{{else}}fa-pause{{/if}}" inert></i>
              <span>{{timerControls.toggleLabel}}</span>
            </button>
            <button type="button" data-action="resetTimer" {{#if timerControls.disabled}}disabled{{/if}}>
              <i class="fa-solid fa-rotate" inert></i>
              <span>{{localize "DRAWING-PROMPTS.manager.actions.resetTimer"}}</span>
            </button>
            <button type="button" data-action="stopTimer" {{#if timerControls.disabled}}disabled{{/if}}>
              <i class="fa-solid fa-stop" inert></i>
              <span>{{localize "DRAWING-PROMPTS.manager.actions.stopTimer"}}</span>
            </button>
          </div>
        </div>
        <div class="dp-timer-adjustments is-plus">
          {{#each timerControls.adjustments}}
          {{#unless this.isMinus}}
          <button type="button" data-action="adjustTimer" data-delta-ms="{{this.deltaMs}}" data-tooltip="{{this.tooltip}}" {{#if ../timerControls.disabled}}disabled{{/if}}>{{this.label}}</button>
          {{/unless}}
          {{/each}}
        </div>
        {{else}}
        <div class="dp-timer-controls">
          <button type="button" data-action="toggleTimer" disabled>
            <i class="fa-solid fa-pause" inert></i>
            <span>{{timerControls.toggleLabel}}</span>
          </button>
          <button type="button" data-action="resetTimer" disabled>
            <i class="fa-solid fa-rotate" inert></i>
            <span>{{localize "DRAWING-PROMPTS.manager.actions.resetTimer"}}</span>
          </button>
          <button type="button" data-action="stopTimer" disabled>
            <i class="fa-solid fa-stop" inert></i>
            <span>{{localize "DRAWING-PROMPTS.manager.actions.stopTimer"}}</span>
          </button>
        </div>
        {{/if}}
      </div>
    </div>

    <div class="dp-players-preview-grid">
      <fieldset class="dp-players-fieldset">
        <legend>
          {{localize "DRAWING-PROMPTS.manager.sections.players"}}
          <span class="dp-muted">{{localize "DRAWING-PROMPTS.manager.liveReview"}}</span>
        </legend>

        <div class="dp-user-list">
          {{#each rows}}
          <div class="dp-user-row {{this.classes}}" data-action="selectAssignment" data-assignment-id="{{this.assignmentId}}">
            <div class="dp-row-control">
              <span class="dp-status-dot" inert></span>
              <span class="dp-status-badge status-{{this.status}}">{{this.statusLabel}}</span>
            </div>

            <div class="dp-user-name">
              <strong>{{this.name}}</strong>
              <div class="dp-user-flags">
                {{#if this.isOffline}}<span>{{localize "DRAWING-PROMPTS.status.offline"}}</span>{{/if}}
                {{#if this.isExpired}}<span>{{localize "DRAWING-PROMPTS.status.expired"}}</span>{{/if}}
                {{#if this.isLate}}<span>{{localize "DRAWING-PROMPTS.status.late"}} {{this.overtimeLabel}}</span>{{/if}}
                {{#if this.windowOpen}}<span>{{localize "DRAWING-PROMPTS.manager.windowOpen"}}</span>{{/if}}
                {{#if this.isSaved}}<span data-tooltip="{{this.savedTooltip}}">{{localize "DRAWING-PROMPTS.manager.saved"}}</span>{{/if}}
              </div>
            </div>

            <div class="dp-row-actions">
              {{#if this.canResend}}
              <button type="button" data-action="resendAssignment" data-assignment-id="{{this.assignmentId}}" data-tooltip aria-label="{{localize 'DRAWING-PROMPTS.manager.actions.resendAssignment'}}">
                <i class="fa-solid fa-paper-plane" inert></i>
              </button>
              {{/if}}
              {{#if this.canCancel}}
              <button type="button" data-action="cancelAssignment" data-assignment-id="{{this.assignmentId}}" data-tooltip aria-label="{{localize 'DRAWING-PROMPTS.manager.actions.cancelAssignment'}}">
                <i class="fa-solid fa-ban" inert></i>
              </button>
              {{/if}}
              {{#if this.canReopen}}
              <button type="button" data-action="reopenAssignment" data-assignment-id="{{this.assignmentId}}" data-tooltip aria-label="{{localize 'DRAWING-PROMPTS.manager.actions.reopenAssignment'}}">
                <i class="fa-solid fa-rotate-left" inert></i>
              </button>
              {{/if}}
              {{#if this.canShow}}
              <button type="button" data-action="showPlayerUi" data-assignment-id="{{this.assignmentId}}" data-tooltip aria-label="{{localize 'DRAWING-PROMPTS.manager.actions.showPlayerUi'}}">
                <i class="fa-solid fa-up-right-from-square" inert></i>
              </button>
              {{/if}}
            </div>
          </div>
          {{else}}
          <p class="dp-empty">{{localize "DRAWING-PROMPTS.manager.empty.noPlayers"}}</p>
          {{/each}}
        </div>
      </fieldset>

      <aside class="dp-preview-panel">
        <fieldset>
          <legend>{{selectedPreviewHeading}}</legend>

          {{#if framingViewToggle.visible}}
          <div class="dp-framing-view-toggle" role="group" aria-label="{{framingViewToggle.label}}">
            <span class="dp-framing-view-label">{{framingViewToggle.label}}</span>
            <div class="dp-button-strip">
              {{#each framingViewToggle.options}}
              <button type="button"
                      data-action="setFramingView"
                      data-framing-view="{{this.value}}"
                      class="{{#if this.selected}}is-selected{{/if}}"
                      aria-pressed="{{this.selected}}">
                <span>{{this.label}}</span>
              </button>
              {{/each}}
            </div>
          </div>
          {{/if}}

          <div class="dp-plate-stage" data-dp-review-stage>
            <div class="dp-preview-frame dp-canvas-plate" data-dp-review-plate>
              {{#if selectedSnapshot}}
              <img src="{{selectedSnapshot}}" alt="{{localize 'DRAWING-PROMPTS.manager.alt.assignmentPreview'}}">
              {{else}}
              <p class="dp-empty">{{localize "DRAWING-PROMPTS.manager.empty.noSnapshot"}}</p>
              {{/if}}
            </div>
          </div>

          {{#if selectedIsSaved}}
          <div class="dp-saved-indicator" data-tooltip="{{selectedSavedTooltip}}">
            <i class="fa-solid fa-floppy-disk" inert></i>
            <span>{{localize "DRAWING-PROMPTS.manager.saved"}}</span>
          </div>
          {{/if}}

          <div class="dp-submission-actions {{#unless selectedCanPlace}}is-place-disabled{{/unless}}">
            <button type="button" data-action="saveAssignment" data-assignment-id="{{selectedAssignmentId}}" {{#unless selectedCanSave}}disabled{{/unless}}>
              <i class="fa-solid fa-floppy-disk" inert></i>
              <span>{{localize "DRAWING-PROMPTS.manager.actions.save"}}</span>
            </button>
            <span class="dp-action-arrow" aria-hidden="true">
              <i class="fa-solid fa-arrow-right" inert></i>
            </span>
            <div class="dp-placement-actions" {{#unless selectedCanPlace}}data-tooltip="{{saveFirstTooltip}}"{{/unless}}>
              <button type="button" data-action="openPlaceDialog" data-assignment-id="{{selectedAssignmentId}}" {{#unless selectedCanPlace}}disabled{{/unless}}>
                <i class="fa-solid fa-map-pin" inert></i>
                <span>{{localize "DRAWING-PROMPTS.manager.actions.place"}}</span>
              </button>
              <span {{#unless selectedCanPlace}}data-tooltip="{{transformSaveFirstTooltip}}"{{/unless}}>
                <button type="button" data-action="applyTransform" data-assignment-id="{{selectedAssignmentId}}" {{#unless selectedCanPlace}}disabled{{/unless}}>
                  <i class="fa-solid fa-paintbrush" inert></i>
                  <span>{{localize "DRAWING-PROMPTS.transform.action"}}</span>
                </button>
              </span>
            </div>
          </div>
        </fieldset>
      </aside>
    </div>
  </div>

  <footer class="dp-action-bar form-footer">
    <button type="button" data-action="openPromptLibrary">
      <i class="fa-solid fa-box-archive" inert></i>
      <span>{{localize "DRAWING-PROMPTS.library.title"}}</span>
    </button>
    {{#if canFinishPrompt}}
    <button class="primary" type="button" data-action="closePrompt">
      <i class="fa-solid fa-flag-checkered" inert></i>
      <span>{{localize "DRAWING-PROMPTS.manager.actions.finishPrompt"}}</span>
    </button>
    {{/if}}
    {{#if canOpenPromptToPlayers}}
    <button class="primary" type="button" data-action="openPromptToPlayers">
      <i class="fa-solid fa-door-open" inert></i>
      <span>Open to Players</span>
    </button>
    {{/if}}
    <button type="button" data-action="cancelAll" {{#if canCancelAll}}{{else}}disabled{{/if}}>
      <i class="fa-solid fa-ban" inert></i>
      <span>{{localize "DRAWING-PROMPTS.manager.actions.cancelAll"}}</span>
    </button>
    <button type="button" data-action="resendAll" {{#if canResendAll}}{{else}}disabled{{/if}}>
      <i class="fa-solid fa-arrows-rotate" inert></i>
      <span>{{localize "DRAWING-PROMPTS.manager.actions.resendAll"}}</span>
    </button>
  </footer>
  {{else}}
  <div class="dp-manager-grid">
    <div class="dp-manager-main">
      <fieldset {{#if setupLocked}}disabled{{/if}}>
        <legend>{{localize "DRAWING-PROMPTS.manager.sections.prompt"}}</legend>

        <div class="form-group">
          <label for="dp-prompt-name">{{localize "DRAWING-PROMPTS.manager.fields.promptName"}}</label>
          <div class="form-fields">
            <input id="dp-prompt-name" type="text" name="promptName" value="{{draft.promptName}}">
          </div>
        </div>

        <div class="form-group stacked">
          <label for="dp-prompt-text">{{localize "DRAWING-PROMPTS.manager.fields.promptTextOptional"}}</label>
          <div class="form-fields">
            <textarea id="dp-prompt-text" name="promptText" rows="4" placeholder="{{localize 'DRAWING-PROMPTS.manager.fields.promptTextOptional'}}">{{draft.promptText}}</textarea>
          </div>
        </div>

        <div class="form-group">
          <label for="dp-timer-seconds">{{localize "DRAWING-PROMPTS.manager.fields.timerSeconds"}}</label>
          <div class="form-fields">
            <input id="dp-timer-seconds" type="number" name="timerSeconds" min="0" step="1" value="{{draft.timerSeconds}}">
          </div>
        </div>

        <div class="form-group slim">
          <label>{{localize "DRAWING-PROMPTS.manager.fields.dimensions"}}</label>
          <div class="form-fields">
            <label for="dp-canvas-width">{{localize "DRAWING-PROMPTS.manager.fields.canvasWidth"}}</label>
            <input id="dp-canvas-width" type="number" name="canvasWidth" min="1" max="{{maxCanvasDim}}" step="1" value="{{draft.canvasWidth}}">
            <label for="dp-canvas-height">{{localize "DRAWING-PROMPTS.manager.fields.canvasHeight"}}</label>
            <input id="dp-canvas-height" type="number" name="canvasHeight" min="1" max="{{maxCanvasDim}}" step="1" value="{{draft.canvasHeight}}">
          </div>
        </div>
      </fieldset>

      <fieldset {{#if setupLocked}}disabled{{/if}}>
        <legend>{{localize "DRAWING-PROMPTS.manager.sections.background"}}</legend>

        <div class="form-group">
          <label>{{localize "DRAWING-PROMPTS.manager.fields.backgroundSource"}}</label>
          <div class="form-fields dp-button-strip">
            <button type="button" data-action="browseBackground">
              <i class="fa-solid fa-folder-open" inert></i>
              <span>{{localize "DRAWING-PROMPTS.manager.actions.browseBackground"}}</span>
            </button>
            <button type="button" data-action="useTokenBackground">
              <i class="fa-solid fa-user" inert></i>
              <span>{{localize "DRAWING-PROMPTS.manager.actions.useTokenBackground"}}</span>
            </button>
            <button type="button" data-action="useTileBackground">
              <i class="fa-solid fa-map" inert></i>
              <span>{{localize "DRAWING-PROMPTS.manager.actions.useTileBackground"}}</span>
            </button>
            <button type="button" data-action="useSceneBackground">
              <i class="fa-solid fa-image" inert></i>
              <span>{{localize "DRAWING-PROMPTS.manager.actions.useSceneBackground"}}</span>
            </button>
            <button type="button" data-action="clearBackground">
              <i class="fa-solid fa-xmark" inert></i>
              <span>{{localize "DRAWING-PROMPTS.manager.actions.clearBackground"}}</span>
            </button>
          </div>
          <p class="hint">{{draft.backgroundLabel}}</p>
        </div>

        <div class="form-group">
          <label for="dp-fit-mode">{{localize "DRAWING-PROMPTS.manager.fields.fitMode"}}</label>
          <div class="form-fields">
            <select id="dp-fit-mode" name="fitMode">
              {{#each fitModes}}
              <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
              {{/each}}
            </select>
          </div>
        </div>
      </fieldset>

      <fieldset class="dp-players-fieldset" {{#if setupLocked}}disabled{{/if}}>
        <legend>
          {{localize "DRAWING-PROMPTS.manager.sections.players"}}
          <span class="dp-muted"><span class="dp-selected-count">{{draft.selectedCount}}</span> {{localize "DRAWING-PROMPTS.manager.selected"}}</span>
        </legend>

        <div class="dp-user-list">
          {{#each rows}}
          <label class="dp-user-row {{this.classes}}">
            <span class="dp-row-control">
              <input type="checkbox" name="selectedUserIds" value="{{this.userId}}" {{#if this.selected}}checked{{/if}} {{#if this.isOffline}}disabled{{/if}}>
            </span>

            <span class="dp-user-name">
              <strong>{{this.name}}</strong>
              <span class="dp-user-flags">
                {{#if this.isOffline}}<span>{{localize "DRAWING-PROMPTS.status.offline"}}</span>{{/if}}
                {{#if this.lacksFileUpload}}<span data-tooltip="{{this.fileUploadTooltip}}">{{localize "DRAWING-PROMPTS.manager.fileUpload.missing"}}</span>{{/if}}
              </span>
            </span>

            <span></span>
          </label>
          {{else}}
          <p class="dp-empty">{{localize "DRAWING-PROMPTS.manager.empty.noPlayers"}}</p>
          {{/each}}
        </div>
      </fieldset>
    </div>

    <aside class="dp-preview-panel">
      <fieldset {{#if setupLocked}}disabled{{/if}}>
        <legend>{{localize "DRAWING-PROMPTS.manager.sections.framing"}}</legend>
        <p class="hint">{{localize "DRAWING-PROMPTS.manager.framing.hint"}}</p>
        <div class="dp-framing-editor" data-dp-framing-editor>
          <div class="dp-plate-stage" data-dp-framing-stage>
            <div class="dp-preview-frame dp-framing-plate dp-canvas-plate">
              <p class="dp-empty" data-dp-framing-empty {{#if draft.hasBackground}}hidden{{/if}}>{{localize "DRAWING-PROMPTS.manager.empty.noBackground"}}</p>
              <canvas data-dp-framing-plate aria-label="{{localize 'DRAWING-PROMPTS.manager.alt.framingEditor'}}" {{#unless draft.hasBackground}}hidden{{/unless}}></canvas>
            </div>
          </div>
          <div class="dp-framing-controls">
            <button type="button" data-action="framingZoomOut" data-tooltip aria-label="{{localize 'DRAWING-PROMPTS.manager.framing.zoomOut'}}" {{#unless draft.hasBackground}}disabled{{/unless}}>
              <i class="fa-solid fa-magnifying-glass-minus" inert></i>
            </button>
            <button type="button" data-action="framingZoomIn" data-tooltip aria-label="{{localize 'DRAWING-PROMPTS.manager.framing.zoomIn'}}" {{#unless draft.hasBackground}}disabled{{/unless}}>
              <i class="fa-solid fa-magnifying-glass-plus" inert></i>
            </button>
            <button type="button" data-action="framingReset" data-tooltip aria-label="{{localize 'DRAWING-PROMPTS.manager.framing.reset'}}" {{#unless draft.hasBackground}}disabled{{/unless}}>
              <i class="fa-solid fa-expand" inert></i>
            </button>
          </div>
        </div>
      </fieldset>
    </aside>
  </div>

  <footer class="dp-action-bar form-footer">
    <button type="button" data-action="savePrompt" {{#unless canSavePrompt}}disabled{{/unless}}>
      <i class="fa-solid fa-floppy-disk" inert></i>
      <span>{{localize "DRAWING-PROMPTS.manager.actions.save"}}</span>
    </button>
      <button type="button" data-action="showPreview" {{#if setupLocked}}disabled{{/if}}>
      <i class="fa-solid fa-eye" inert></i>
      <span>{{localize "DRAWING-PROMPTS.manager.actions.showPreview"}}</span>
    </button>
    <button class="primary" type="button" data-action="sendPrompt" {{#if canSend}}{{else}}disabled{{/if}}>
      <i class="fa-solid fa-paper-plane" inert></i>
      <span>{{sendLabel}}</span>
    </button>
  </footer>
  {{/if}}
</div>
