{
  "id": "drawing-prompts",
  "title": "Drawing Prompts",
  "description": "A module to handle GM-to-player drawing prompts.",
  "version": "0.1.2",
  "compatibility": {
    "minimum": "13",
    "verified": "14.364"
  },
  "socket": true,
  "url": "https://github.com/Mullans/FoundryDrawingPrompt",
  "manifest": "https://github.com/Mullans/FoundryDrawingPrompt/releases/latest/download/module.json",
  "download": "https://github.com/Mullans/FoundryDrawingPrompt/releases/download/v0.1.2/module.zip",
  "bugs": "https://github.com/Mullans/FoundryDrawingPrompt/issues",
  "esmodules": [
    "scripts/module.mjs"
  ],
  "styles": [
    {
      "src": "styles/module.css"
    }
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json",
      "flags": {}
    }
  ],
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "hbs",
        "json"
      ],
      "paths": [
        "styles",
        "templates",
        "lang"
      ]
    }
  },
  "relationships": {
    "requires": [
      {
        "id": "socketlib",
        "type": "module",
        "compatibility": {}
      }
    ]
  },
  "authors": [
    {
      "name": "Sean",
      "flags": {}
    }
  ]
}